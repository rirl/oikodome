{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "KIOS CLI",
      "type": "debugpy",
      "request": "launch",
      "module": "kios",
      "args": [
        "investigate",
        "What is embodied cognition?"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pytest Current File",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
